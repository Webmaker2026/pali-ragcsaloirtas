# =========================================================
# A-Leco Management Kft. — patkanyirtasbudapest.hu
# Apache konfiguráció megosztott tárhelyhez.
# Minden modulfüggő szabály <IfModule> blokkba van csomagolva,
# hogy hiányzó modul esetén se okozzon 500-as hibát.
# =========================================================

# --- Karakterkódolás ---------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType text/html .html
  AddCharset UTF-8 .html .css .js .xml .txt
</IfModule>

# --- Egyedi hibaoldal ----------------------------------------------------
ErrorDocument 404 /404.html

# --- HTTPS + www kényszerítése -------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTP -> HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # non-www -> www (kanonikus verzió: www.patkanyirtasbudapest.hu)
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Tömörítés -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Böngésző-gyorsítótár ----------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Alapvető biztonsági fejlécek ---------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Könyvtárlistázás tiltása --------------------------------------------
Options -Indexes
